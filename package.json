{
  "name": "rabbitmq-action",
  "version": "1.0.0",
  "description": "GitHub Action for publishing payloads to RabbitMQ or AMQP exchanges and queues.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "amqplib": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}